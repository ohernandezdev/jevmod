# Required by every role
TYPESAFE_API_KEY=            # https://console.typesafe.ai/settings/keys

# HTTP API (role: api)
JEVMOD_ADMIN_TOKEN=          # long random string; used once to mint tenant API keys via POST /v1/keys
PORT=8080

# Discord (role: discord)     Developer Portal -> Bot -> Reset Token; enable Message Content Intent
DISCORD_TOKEN=

# Telegram (role: telegram)   @BotFather -> /newbot
TELEGRAM_TOKEN=

# Reddit (role: reddit)       https://www.reddit.com/prefs/apps (script app), moderator account
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_SUBREDDITS=

# The per-server cost guard lives in the hosted plans block at the end of this file: JEVMOD_MONTHLY_QUOTA.

# Characters of message text kept in the local decision log (0 = none; the hosted bot runs with 0)
JEVMOD_KEEP_TEXT_CHARS=300

# Storage: SQLite file; in Docker this points at the /data volume
JEVMOD_DB=/data/jevmod.sqlite

# Public demo (role: demo). The key stays here; the page only talks to this endpoint.
JEVMOD_DEMO_BUDGET_USD=0.5          # hard monthly cap on Jev spend, from measured tokens
JEVMOD_DEMO_PER_MINUTE=6            # per visitor
JEVMOD_DEMO_PER_DAY=40
JEVMOD_DEMO_MAX_CHARS=300
JEVMOD_DEMO_ORIGINS=https://jevmod.dev,https://www.jevmod.dev   # comma separated; only these pages may call it
JEVMOD_DEMO_SALT=change-me          # IPs are stored hashed with this salt

# Hosted plans (role: hosted = demo + billing + admin panel at /admin?token=JEVMOD_ADMIN_TOKEN)
JEVMOD_PUBLIC_URL=https://jevmod.dev
JEVMOD_MONTHLY_QUOTA=5000           # judged messages per server per month; 0 = unlimited
# Plans only mean something on the hosted service. Leave this at 0, or unset, in a self-hosted copy:
# there is no billing there, every tenant reads as the default plan, and everything is judged. The
# hosted service sets it to 1, and a server that never subscribed, or whose trial or subscription has
# ended, is inactive: it is not judged, and its link, word, pattern and raid rules do not run either.
# The old name for this was JEVMOD_MODEL_ON_FREE, inverted; it is still read as a fallback so an
# un-updated deployment keeps the behaviour it had.
JEVMOD_ENFORCE_PLANS=0
JEVMOD_PRO_MONTHLY_QUOTA=50000      # Pro; 0 = unlimited
STRIPE_PRICE_ID=                    # price_... of the monthly Pro product
STRIPE_SECRET_KEY=                  # sk_live_... (or sk_test_...)
STRIPE_WEBHOOK_SECRET=              # whsec_... of the endpoint https://<host>/billing/stripe/webhook

# Twitch. An app at https://dev.twitch.tv/console/apps gives the id and secret; the refresh token is a
# *user* token for the bot account, with chat:read, moderator:manage:banned_users and
# moderator:manage:chat_messages, and that account must be a moderator of every channel it watches.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REFRESH_TOKEN=
TWITCH_BOT_LOGIN=
TWITCH_CHANNELS=

# YouTube. OAuth credentials from https://console.cloud.google.com/apis/credentials and a user token
# with the youtube.force-ssl scope, for an account that owns or moderates the live chat. One live
# stream at a time: YOUTUBE_VIDEO_ID is the stream being watched.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=
YOUTUBE_VIDEO_ID=
